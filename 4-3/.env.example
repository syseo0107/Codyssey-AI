# 이 파일을 복사해 같은 폴더에 .env 로 저장하고 값을 채운다.
# .env 는 .gitignore 에 들어 있어 GitHub에 올라가지 않는다.

# 노션 통합(Integration)의 Internal Integration Secret (ntn_ 으로 시작)
NOTION_TOKEN=

# DB를 만들 노션 페이지의 링크 또는 32자리 ID
NOTION_PARENT_PAGE=

# OpenAI API 키 (sk- 로 시작). 로컬 시험(tools/pipeline-test.js)에만 쓴다. n8n에는 따로 등록한다.
# 비워 두면 LIBRECHAT_ENV 파일(리브레챗 .env)의 OPENAI_API_KEY 를 읽는다.
OPENAI_API_KEY=
LIBRECHAT_ENV=/Users/bea/Desktop/LibreChat/.env

# Gemini API 키 (Google AI Studio에서 발급, AIza 로 시작). 대표 이미지 생성에 쓴다.
GEMINI_API_KEY=

# 아래 두 값은 tools/notion-setup.js 가 DB를 만든 뒤 자동으로 채운다
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=
